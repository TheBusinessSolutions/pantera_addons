<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--for the invoice-->
    <record id="view_move_form_pantera" model="ir.ui.view">
        <field name="name">view.move.form.pantera</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="total_refund_amount"/>
            </xpath>
        </field>
    </record>

        <!-- NEW: Print with Stamp Button -->
    <record id="view_move_form_pantera_stamp_button" model="ir.ui.view">
        <field name="name">account.move.form.pantera.stamp.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- Placed before the Send by Email button in the header area -->
            <xpath expr="//button[@name='action_invoice_sent']" position="before">
                <button name="print_pantera_inv_with_stamp"
                        string="Print with Stamp"
                        type="object"
                        class="btn-secondary"
                        icon="fa-stamp"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_inherit_bill_pantera" model="ir.ui.view">
        <field name="name">account.move.tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total_signed']" position="before">
                <field name="total_refund_amount" sum="Total Refund" string="Total Claim"/>
            </xpath>
        </field>
    </record>
    <record id="view_move_tree_inherit_invoice_pantera" model="ir.ui.view">
        <field name="name">account.move.tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total_signed']" position="before">
                <field name="total_refund_amount" sum="Total Refund" string="Total Claim"/>
            </xpath>
        </field>
    </record>


</odoo>