<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_company_form_pantera_stamp" model="ir.ui.view">
        <field name="name">res.company.form.pantera.stamp</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Pantera Settings" name="pantera_settings">
                    <group>
                        <field name="pantera_stamp_image" widget="image" class="oe_avatar"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>