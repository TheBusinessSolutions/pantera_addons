<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 1. Paper Format: Adjusted Header Spacing -->
        <record id="paperformat_report_packing_pantera" model="report.paperformat">
            <field name="name">Pantera Packing List</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">35</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">45</field> <!-- Increased from 30 to 45 to prevent overlap -->
            <field name="dpi">90</field>
        </record>

        <!-- 2. External Layout: Reduced Logo Height -->
        <template id="external_layout_packing_pantera">
            <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"/>
            </t>
            <t t-if="not o or not 'company_id' in o">
                <t t-set="company" t-value="res_company"/>
            </t>
            
            <!-- Header with Left Alignment -->
            <div class="header" style="text-align: left; margin-bottom: 5px;">
                <t t-if="doc.with_context(lang='en_US').brand_id">
                    <!-- Reduced max-height to 100px -->
                    <img t-att-src="image_data_uri(doc.brand_id.image_1920)" style="max-height: 200px; object-fit: contain;" alt="Logo"/>
                </t>
                <t t-else="">
                    <!-- Reduced max-height to 100px -->
                    <img t-att-src="image_data_uri(company.logo)" style="max-height: 200px; object-fit: contain;" alt="Logo"/>
                </t>
            </div>

            <div class="article o_report_layout_standard" style="font-family: 'Tajawal-Regular', Arial, sans-serif; font-size: 11px;">
                <t t-raw="0"/>
                <!-- Company Stamp: inside printable article -->
                <t t-if="company and company.pantera_stamp_image">
                    <div style="width: 100%; text-align: right;
                                margin-top: 10px; padding-right: 20px;">
                        <img t-att-src="image_data_uri(company.pantera_stamp_image)"
                             style="width: 140px; max-height: 140px;
                                    object-fit: contain;"
                             alt="Company Stamp"/>
                    </div>
                </t>
            </div>

            <!-- Footer with Stamp Placement -->
            <div class="footer o_background_footer" style="position: relative; min-height: 150px;">
                <!-- <t t-if="company.pantera_stamp_image">
                    <div style="position: absolute; bottom: 10px; right: 10px; opacity: 0.9; z-index: 100;">
                        <img t-att-src="image_data_uri(company.pantera_stamp_image)" 
                             style="max-width: 140px; max-height: 140px; object-fit: contain;"/>
                    </div>
                </t> -->
                <div class="text-center text-muted" style="font-size: 10px; margin-top: 10px;">
                    Page: <span class="page"/> of <span class="topage"/>
                </div>
            </div>
        </template>

        <!-- 3. Document Template (Unchanged) -->
        <template id="report_packing_pantera_document">
            <t t-foreach="doc" t-as="o">
                <t t-call="pantera_invoice.external_layout_packing_pantera">
                    <div class="page">
                        
                        <!-- Title -->
                        <div style="text-align: center; margin-bottom: 15px; font-size: 14px; font-weight: bold;">
                            PACKING LIST
                        </div>

                        <!-- Compact Info Grid (Shipper | Consignee | Details) -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px; font-size: 11px;">
                            <tr>
                                <!-- Shipper Column -->
                                <td style="width: 35%; vertical-align: top; padding: 5px; border: 1px solid #ddd;">
                                    <strong>Shipper:</strong><br/>
                                    <t t-esc="o.company_id.name"/><br/>
                                    <t t-esc="o.company_id.street"/><br/>
                                    <t t-esc="o.company_id.city"/>, <t t-esc="o.company_id.country_id.name"/><br/>
                                    Tax ID: <t t-esc="o.company_id.vat"/>
                                </td>
                                
                                <!-- Consignee Column -->
                                <td style="width: 35%; vertical-align: top; padding: 5px; border: 1px solid #ddd;">
                                    <strong>Consignee:</strong><br/>
                                    <t t-esc="o.partner_id.name"/><br/>
                                    <t t-esc="o.partner_id.street"/><br/>
                                    <t t-esc="o.partner_id.city"/>, <t t-esc="o.partner_id.country_id.name"/><br/>
                                    VAT: <t t-esc="o.partner_id.vat"/><br/>
                                    Tel: <t t-esc="o.partner_id.phone"/>
                                </td>

                                <!-- Invoice Details Column -->
                                <td style="width: 30%; vertical-align: top; padding: 5px; border: 1px solid #ddd;">
                                    <table style="width: 100%; font-size: 11px;">
                                        <tr><td><strong>Invoice No:</strong></td><td style="text-align: right;"><t t-esc="o.name"/></td></tr>
                                        <tr><td><strong>Date:</strong></td><td style="text-align: right;"><t t-esc="o.invoice_date"/></td></tr>
                                        <tr><td><strong>Vessel:</strong></td><td style="text-align: right;"><t t-esc="o.vessel"/></td></tr>
                                        <tr><td><strong>Seller:</strong></td><td style="text-align: right;"><t t-esc="o.seller_id.name"/></td></tr>
                                        <tr><td><strong>Exporter:</strong></td><td style="text-align: right;"><t t-esc="o.exporter_id.name"/></td></tr>
                                    </table>
                                </td>
                            </tr>
                            <!-- Second Row for Logistics Details -->
                            <tr>
                                <td colspan="3" style="padding: 0;">
                                    <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                        <tr>
                                            <td style="width: 25%; padding: 5px; border: 1px solid #ddd;"><strong>POL:</strong> <t t-esc="o.pol"/></td>
                                            <td style="width: 25%; padding: 5px; border: 1px solid #ddd;"><strong>POD:</strong> <t t-esc="o.pod"/></td>
                                            <td style="width: 25%; padding: 5px; border: 1px solid #ddd;"><strong>Container No:</strong> <t t-esc="o.invoice_line_ids[:1].container_no"/></td>
                                            <td style="width: 25%; padding: 5px; border: 1px solid #ddd;"><strong>Lot No:</strong> -</td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 5px; border: 1px solid #ddd;"><strong>ETD:</strong> <t t-esc="o.etd_date"/></td>
                                            <td style="padding: 5px; border: 1px solid #ddd;"><strong>ETA:</strong> <t t-esc="o.eta_date"/></td>
                                            <td colspan="2" style="padding: 5px; border: 1px solid #ddd;"></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- Main Data Table -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px; font-size: 11px;">
                            <thead>
                                <tr style="background-color: #f2f2f2; border: 1px solid #000;">
                                    <th style="padding: 6px; border: 1px solid #000; text-align: left;">Container</th>
                                    <th style="padding: 6px; border: 1px solid #000; text-align: right;">Quantity</th>
                                    <th style="padding: 6px; border: 1px solid #000; text-align: left;">Box Type</th>
                                    <th style="padding: 6px; border: 1px solid #000; text-align: left;">Product</th>
                                    <th style="padding: 6px; border: 1px solid #000; text-align: left;">Variety</th>
                                    <th style="padding: 6px; border: 1px solid #000; text-align: right;">G.W (KG)</th>
                                    <th style="padding: 6px; border: 1px solid #000; text-align: right;">Total Gross</th>
                                    <th style="padding: 6px; border: 1px solid #000; text-align: right;">N.W (KG)</th>
                                    <th style="padding: 6px; border: 1px solid #000; text-align: right;">Total Net</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="total_gross" t-value="0"/>
                                <t t-set="total_net" t-value="0"/>
                                <t t-set="total_boxes" t-value="0"/>
                                <t t-set="unique_containers" t-value="[]"/>
                                
                                <t t-foreach="doc.invoice_line_ids.filtered(lambda l: l.display_type == 'product')" t-as="line">
                                    <t t-set="line_gross" t-value="(line.product_id.weight or 0) * line.quantity"/>
                                    <t t-set="line_net" t-value="(line.product_id.net_weight or 0) * line.quantity"/>
                                    
                                    <t t-set="total_gross" t-value="total_gross + line_gross"/>
                                    <t t-set="total_net" t-value="total_net + line_net"/>
                                    <t t-set="total_boxes" t-value="total_boxes + line.quantity"/>

                                    <t t-if="line.container_no and line.container_no not in unique_containers">
                                        <t t-set="unique_containers" t-value="unique_containers + [line.container_no]"/>
                                    </t>

                                    <tr style="border: 1px solid #000;">
                                        <td style="padding: 5px; border: 1px solid #000;"><t t-esc="line.container_no"/></td>
                                        <td style="padding: 5px; border: 1px solid #000; text-align: right;"><t t-esc="'{:,.0f}'.format(line.quantity)"/></td>
                                        <td style="padding: 5px; border: 1px solid #000;"><t t-esc="line.pantera_product_box_id.name"/></td>
                                        <td style="padding: 5px; border: 1px solid #000;"><t t-esc="line.product_id.name"/></td>
                                        <td style="padding: 5px; border: 1px solid #000;"><t t-esc="line.pantera_product_variety_id.name"/></td>
                                        <td style="padding: 5px; border: 1px solid #000; text-align: right;"><t t-esc="'{:,.2f}'.format(line.product_id.weight)"/></td>
                                        <td style="padding: 5px; border: 1px solid #000; text-align: right;"><t t-esc="'{:,.2f}'.format(line_gross)"/></td>
                                        <td style="padding: 5px; border: 1px solid #000; text-align: right;"><t t-esc="'{:,.2f}'.format(line.product_id.net_weight)"/></td>
                                        <td style="padding: 5px; border: 1px solid #000; text-align: right;"><t t-esc="'{:,.2f}'.format(line_net)"/></td>
                                    </tr>
                                </t>
                                
                                <!-- Totals Row -->
                                <tr style="background-color: #f9f9f9; font-weight: bold; border: 1px solid #000;">
                                    <td colspan="2" style="padding: 5px; border: 1px solid #000; text-align: right;">TOTALS:</td>
                                    <td style="padding: 5px; border: 1px solid #000;"></td>
                                    <td style="padding: 5px; border: 1px solid #000;"></td>
                                    <td style="padding: 5px; border: 1px solid #000;"></td>
                                    <td style="padding: 5px; border: 1px solid #000;"></td>
                                    <td style="padding: 5px; border: 1px solid #000; text-align: right;"><t t-esc="'{:,.2f}'.format(total_gross)"/></td>
                                    <td style="padding: 5px; border: 1px solid #000;"></td>
                                    <td style="padding: 5px; border: 1px solid #000; text-align: right;"><t t-esc="'{:,.2f}'.format(total_net)"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Summary Section -->
                        <div style="margin-top: 15px; font-size: 11px;">
                            <table style="width: 100%; border-collapse: collapse;">
                                <tr>
                                    <td style="width: 50%; vertical-align: top;">
                                        <table style="width: 100%; border: 1px solid #000;">
                                            <tr style="background-color: #f2f2f2;">
                                                <td colspan="2" style="padding: 5px; border: 1px solid #000; text-align: center;"><strong>Summary</strong></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 5px; border: 1px solid #000; width: 70%;"><strong>Total Number of Boxes:</strong></td>
                                                <td style="padding: 5px; border: 1px solid #000; text-align: right;"><t t-esc="'{:,.0f}'.format(total_boxes)"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 5px; border: 1px solid #000;"><strong>Total Number of Containers:</strong></td>
                                                <td style="padding: 5px; border: 1px solid #000; text-align: right;"><t t-esc="len(unique_containers)"/></td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td style="width: 50%;"></td>
                                </tr>
                            </table>
                        </div>

                    </div>
                </t>
            </t>
        </template>

        <!-- Wrapper -->
        <template id="report_packing_pantera">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="pantera_invoice.report_packing_pantera_document"/>
                </t>
            </t>
        </template>

        <!-- Report Action -->
        <record id="action_report_packing_pantera" model="ir.actions.report">
            <field name="name">Pantera Packing List</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">pantera_invoice.report_packing_pantera</field>
            <field name="report_file">pantera_invoice.report_packing_pantera</field>
            <field name="print_report_name">'Packing List - %s' % (object.name)</field>
            <field name="paperformat_id" ref="pantera_invoice.paperformat_report_packing_pantera"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>